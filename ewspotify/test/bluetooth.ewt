# Bluetooth app smoke test (no phone needed). Remote page comes up and
# advertises; keys are refused while nothing is paired; the scanner runs;
# leaving shuts BLE down and re-entering brings the remote back.
goto Bluetooth
expect log BLE.*remote.advertising 6000
expect screen Bluetooth
tap 120 145
expect log BLE.*playpause.dropped 2000
tap 60 230
expect log BLE.*voldown.dropped 2000
tap 207 22
expect log BLE.*mode=scan 2000
expect log BLE.*scan.n=2 10000
btn short
expect log BLE.*mode=remote 4000
btn short
wait 3000
expect screen AppList
expect log BLE.*deinit 5000
goto Bluetooth
expect log BLE.*remote.advertising 6000
expect noerr
