# EWatchOS2.1 tour: watch faces, launcher sheet, scroll, open Stopwatch, run it, back out.
# ./ewsimrec EWatchOS2.1 out/tour.mp4 examples/tour.ewt --short
wait 800
swipe l          # next watch face
wait 1200
swipe l
wait 1200
swipe l
wait 1200
swipe u          # launcher slides up
wait 900
drag 120 220 120 90 500
wait 700
drag 120 90 120 220 500
wait 700
tap 150 190      # Stopwatch row
wait 900
tap 66 228       # Start
wait 2500
tap 66 228       # Stop
wait 800
btn short        # side button = back
wait 900
swipe r          # swipe right = back (to the watch face)
wait 900
