# Craft (ewcraft): look around the island, walk, mine a block, place one, jump.
# ./ewsimrec ewcraft out/craft.mp4 examples/craft.ewt --short
# Touch controls (craft.h): drag in the left third = walk stick, drag elsewhere = look,
# tap = mine, long press = place, double tap = jump, tap the hotbar = pick a block.
goto Craft
wait 1000
drag 100 140 220 150 1500    # look right
wait 300
drag 220 150 100 130 2400    # pan back left, slowly
wait 300
drag 40 160 40 125 1000      # short walk forward
wait 300
tap 130 140                  # mine
wait 700
tap 130 140                  # mine again
wait 700
tap 156 262                  # hotbar: pick a block
wait 400
long 130 150 900             # place it
wait 800
dtap 160 120                 # jump
wait 1200
snap craft
