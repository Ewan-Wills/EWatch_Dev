# module test: build with EW_APPS=blecontrols
# blecontrols smoke: BLE comes up and advertises, screen draws, back exits and
# tears the radio down, re-entry re-inits (deinit/init cycle), no errors.
goto BleControls
expect screen BleControls
expect log BLECTL: advertising 5000
expect noerr
snap boot
btn short
# BLE teardown takes ~0.3-1 s here (the OS also runs the background BT remote)
wait 1500
expect screen AppList
expect log BLECTL: deinit 3000
goto BleControls
expect log BLECTL: advertising 5000
expect noerr
