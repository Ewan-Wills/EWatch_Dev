# module test: build with EW_APPS=screenshare
# Opens Screenshare with the USB takeover live (no keepcon): ewt still talks
# to the watch because the app passes "sim ..." lines to ewsim between packets.
# The streaming itself is measured by companions/screenshare/screenshare.py.
goto Screenshare
expect screen Screenshare
wait 800
expect noerr
snap boot
