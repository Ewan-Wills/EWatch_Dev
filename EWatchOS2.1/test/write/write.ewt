# Write smoke test (new UI: no chips; shift + delete buttons, CNN + English context).
# ewt -P . run test/write/write.ewt   (build with EW_APPS including write)
goto AppList
wait 300
goto Write
wait 500
expect screen Write
# clear: hold delete (repeats, then whole words)
long 210 250 5000
wait 300
# H in three strokes, any order
touch down 105 120
touch move 105 150
touch move 105 180
touch move 105 210
touch move 105 240
touch up
touch down 175 120
touch move 175 150
touch move 175 180
touch move 175 210
touch move 175 240
touch up
touch down 105 180
touch move 130 180
touch move 150 180
touch move 175 180
touch up
expect log WRITE:.*char=H 1500
# I
touch down 140 120
touch move 140 160
touch move 140 200
touch move 140 240
touch up
expect log WRITE:.*char=I 1500
# space: straight stroke left to right (must not be "back")
touch down 50 200
touch move 90 201
touch move 130 201
touch move 170 202
touch move 200 202
touch up
expect log WRITE:.*edit=space 1500
expect screen Write
# delete button: tap = one character
tap 210 250
expect log WRITE:.*edit=backspace 1000
# shift: next letter upper case
tap 30 250
expect log WRITE:.*case=shift 1000
expect noerr
btn short
wait 400
expect screen AppList
