#!/usr/bin/env python3
"""ewsimrec: render EWatch app footage offline (no watch) and export an MP4.

  ewsimrec PROJECT OUT.mp4 "STEPS" [options]     record (+ OUT.sheet.png contact sheet)
  ewsimrec PROJECT OUT.mp4 script.ewt [options]  steps from an .ewt file
  ewsimrec PROJECT --snap DIR "STEPS"            run steps, `snap NAME` PNGs into DIR, no video
  ewsimrec PROJECT --screens                     screen names (from the project's model.h)

PROJECT = folder under ~/Documents/EWatch/EWatch_Firmware (EWatchOS2.1, ewcraft,
flypet, stocks, ...) or a path. The project is compiled for the Mac on first use
(build/<project>/ewsim) and rebuilt when its sources change.

STEPS use the ewt language: goto NAME | tap X Y | dtap X Y | long X Y [MS] |
drag X1 Y1 X2 Y2 [MS] | swipe u|d|l|r | btn short|long|down|up|hold MS |
tilt GX GY GZ | tilt off | shake [MS] | wait MS | snap NAME | state |
expect screen NAME | expect log RE [MS] | expect nolog RE | expect noerr |
expect fps MIN | keepcon on|off | raw LINE | show [RE] | xcheck

Options (same meaning as `ewt record`):
  --fps N (30)  --scale N (4 = 960x1120)  --smooth  --short (pad to 1080x1920)
  --lead MS (600)  --hold MS (1000)
Simulator options:
  --env ENV          PlatformIO env to take build flags from (ewatch; ewatch_v20)
  --time HH:MM[:SS]  --date YYYY-MM-DD   watch clock at boot (2026-10-07 10:09:30)
  --pref NS.KEY=VAL  NVS preference before boot, e.g. ewatch.wfStyle=2 (watch face)
  --sleep            keep the real dim / screensaver / screen-off timeouts
                     (default for footage: the screen never dims or sleeps)
  --fs DIR           copy DIR into the simulated LittleFS (e.g. photos under img/)
  --boot MS          simulated boot time before recording (1500)
  --seed N           PRNG seed; --allow-unsupported; -v (watch console to stderr)

Exit codes: 0 PASS, 1 a step/expect failed, 2 bad script/usage, 3 a not-simulated
(BLE) app was opened, 4 empty footage (every frame one flat colour), 5 deadlock,
70 firmware panic, 71 crash.
"""
import os, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))
PASS_OPTS = {"--fps", "--scale", "--lead", "--hold", "--boot", "--time", "--date", "--pref",
             "--fs", "--seed"}
FLAG_OPTS = {"--smooth", "--short", "--sleep", "--allow-unsupported", "-v", "--verbose"}


def die(msg, code=2):
    print("ewsimrec: " + msg, file=sys.stderr)
    sys.exit(code)


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    proj, rest = a[0], a[1:]
    env, out, snapdir, screens = "ewatch", None, None, False
    passthru, positional = [], []
    i = 0
    while i < len(rest):
        x = rest[i]
        if x == "--env":
            env = rest[i + 1]; i += 2; continue
        if x == "--snap":
            snapdir = rest[i + 1]; i += 2; continue
        if x == "--screens":
            screens = True; i += 1; continue
        if x in PASS_OPTS:
            if i + 1 >= len(rest):
                die(f"{x} needs a value")
            passthru += [x, rest[i + 1]]; i += 2; continue
        if x in FLAG_OPTS:
            passthru.append(x); i += 1; continue
        if x.startswith("-") and not x.lstrip("-").replace(".", "").isdigit():
            die(f"unknown option {x} (see ewsimrec --help)")
        positional.append(x); i += 1

    # build (quiet unless it fails)
    r = subprocess.run(["make", "-C", HERE, f"PROJ={proj}", f"ENV={env}"], capture_output=True, text=True)
    if r.returncode != 0:
        errs = [l for l in (r.stdout + r.stderr).splitlines() if "error" in l.lower() or "ewsim:" in l]
        die("build failed for " + proj + ":\n  " + "\n  ".join((errs or (r.stdout + r.stderr).splitlines())[-25:]), 2)
    bindir = os.path.join(HERE, "build", os.path.basename(os.path.abspath(proj)) if os.path.isdir(proj) else os.path.basename(proj))
    exe = os.path.join(bindir, "ewsim")
    if not os.path.isfile(exe):
        die(f"no binary at {exe}")
    if screens:
        return subprocess.run([exe, "--screens"]).returncode

    if snapdir is None:
        if not positional or not positional[0].endswith((".mp4", ".mov", ".mkv")):
            die("usage: ewsimrec PROJECT OUT.mp4 \"STEPS\" [options]  (or --snap DIR \"STEPS\")")
        out = os.path.abspath(positional.pop(0))
        os.makedirs(os.path.dirname(out), exist_ok=True)
        snapdir = os.path.dirname(out)
    os.makedirs(snapdir, exist_ok=True)
    cmd = [exe, "--snapdir", snapdir] + passthru
    if out:
        cmd += ["--out", out]
    for p in positional:
        if p.endswith(".ewt") and os.path.isfile(p):
            cmd += ["--script-file", p]
        else:
            cmd.append(p)
    rc = subprocess.run(cmd).returncode
    if out and os.path.isfile(out):
        pr = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-count_frames",
                             "-show_entries", "stream=codec_name,width,height,r_frame_rate,nb_read_frames,pix_fmt",
                             "-show_entries", "format=duration", "-of", "default=nw=1", out],
                            capture_output=True, text=True)
        kv = dict(l.split("=", 1) for l in pr.stdout.split() if "=" in l)
        print(f"ffprobe: {kv.get('width')}x{kv.get('height')} {kv.get('codec_name')} {kv.get('pix_fmt')} "
              f"{kv.get('r_frame_rate')} fps, {kv.get('nb_read_frames')} frames, {float(kv.get('duration', 0)):.2f} s")
    return rc


if __name__ == "__main__":
    sys.exit(main())
