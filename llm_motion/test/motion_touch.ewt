# Motion LM: swipe/tap phrases through the real touch path (CST816S gesture
# codes injected at the controller -> Gesture events -> MotionView -> LM).
# Same-direction swipes need > 400 ms spacing (the controller dedups repeats).
goto Motion
wait 300
swipe u
wait 250
swipe u
expect log MOTION:.gesture=swipe_uu.p= 2000
expect log label=swipe_uu.dry=1 500
wait 300
swipe l
swipe r
swipe l
expect log MOTION:.gesture=swipe_lrl.p= 2000
wait 300
swipe d
wait 250
swipe d
expect log MOTION:.gesture=swipe_dd.p= 2000
wait 300
dtap 120 140
swipe r
expect log MOTION:.gesture=tap_tap_r.p= 2000
wait 300
# negative: a lone swipe is not a command
swipe u
expect log MOTION:.gesture=none.p= 2000
# swipe right did NOT leave the app (it is a token here, not "back")
expect screen Motion
expect noerr
