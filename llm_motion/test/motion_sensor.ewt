# Motion LM through the REAL accelerometer path: ewsim tilt/shake override the
# MMA8451 reading inside the controller's 50 Hz I/O loop -> motionFeedSample.
# tilt steps are coarse (each holds ~60-110 ms), so gestures are staircases.
goto Motion
tilt 0 0 1
wait 800
# --- shake: ewsim's +-1.7 g x-axis square wave
shake 800
expect log MOTION:.gesture=shake.p= 3000
wait 600
# --- twist left: roll about X (gravity +Z -> -Y) and back
tilt 0 -0.5 0.87
tilt 0 -0.87 0.5
tilt 0 -1 0
tilt 0 -0.87 0.5
tilt 0 -0.5 0.87
tilt 0 0 1
expect log MOTION:.gesture=twist_l.p= 3000
wait 600
# --- twist right
tilt 0 0.5 0.87
tilt 0 0.87 0.5
tilt 0 1 0
tilt 0 0.87 0.5
tilt 0 0.5 0.87
tilt 0 0 1
expect log MOTION:.gesture=twist_r.p= 3000
wait 600
# --- raise: arm hanging (gravity on -X) -> face up
tilt -1 0 0
wait 1200
tilt -0.87 0 0.5
tilt -0.5 0 0.87
tilt -0.17 0 0.98
tilt 0 0 1
expect log MOTION:.gesture=raise.p= 3000
wait 600
# --- lower: face up -> hanging
tilt -0.17 0 0.98
tilt -0.5 0 0.87
tilt -0.87 0 0.5
tilt -1 0 0
expect log MOTION:.gesture=lower.p= 3000
tilt 0 0 1
wait 1500
# --- negative: small fidgets -> no gesture
tilt 0.15 0.1 0.98
tilt -0.1 0.2 0.97
tilt 0.12 -0.15 0.98
tilt 0 0 1
wait 1200
expect nolog gesture=(?!none)
expect noerr
