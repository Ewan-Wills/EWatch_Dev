{
  "name": "claude-bridge",
  "version": "0.1.0",
  "description": "Host daemon that bridges Claude Code session state to the EWatch Claude Face over USB serial.",
  "private": true,
  "type": "commonjs",
  "bin": {
    "claude-bridge": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "npm run build && node dist/src/cli.js"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0"
  }
}
